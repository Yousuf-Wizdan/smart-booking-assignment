# Local development placeholders only. Copy to real environment variables;
# Spring Boot does not read .env files by itself.
DATABASE_URL=jdbc:postgresql://localhost:5432/smart_booking
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=changeme
APP_COMPANY_TIME_ZONE=Asia/Kolkata
# >= 32 bytes. Leave unset for a random per-boot dev secret (tokens won't survive restart).
BOOKING_JWT_SECRET=
BOOKING_JWT_EXPIRY_MINUTES=480
# Dev-only admin bootstrap. Keep false unless you need seed logins locally.
APP_BOOTSTRAP_ENABLED=false
APP_BOOTSTRAP_ADMIN_USERNAME=
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOOTSTRAP_APPROVER_USERNAME=
APP_BOOTSTRAP_APPROVER_PASSWORD=
